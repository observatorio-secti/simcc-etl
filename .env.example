WRITE_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/simcc_write"
READ_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/simcc"
ADMIN_DATABASE_URL="postgresql+psycopg://db_user:db_password@localhost:5432/db"
REDIS_URL="redis://localhost:6379/0"
ETL_API_KEY="simcc-etl-secret-key"
ADMIN_API_URL="http://localhost:8009"
ADMIN_SERVICE_TOKEN="change-this-in-production-service-token"
# Hop Server long-lived (serviço `hop` do compose.yaml). Com o ETL em
# container, o compose.yaml injeta HOP_SERVER_URL=http://hop:8080.
HOP_SERVER_URL="http://localhost:8080"
HOP_SERVER_USER="cluster"
HOP_SERVER_PASSWORD="cluster"
HOP_SERVER_TIMEOUT=21600
HOP_WRITE_JDBC_URL="jdbc:postgresql://write_db:5432/simcc_write?user=postgres&password=postgres"
HOP_ADMIN_JDBC_URL="jdbc:postgresql://admin_db:5432/db?user=db_user&password=db_password"
STORAGE_DIR="storage"
# Só para o compose.yaml: pasta do host montada como storage do `etl`; a
# subpasta xml/hop_input é montada no `hop` (crie-a antes do `up`).
STORAGE_PATH="./storage"
LOG_DIR="logs"
ALTERNATIVE_CNPQ_SERVICE=true
CNPQ_PROXY_URL="https://simcc.uesc.br/v3/api"
SOAP_MAX_WORKERS=16
OPENALEX_API_KEY=""
OPENALEX_BATCH_COMMIT_SIZE=50
